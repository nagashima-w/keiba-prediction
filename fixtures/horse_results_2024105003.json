{"status":"OK","data":"\n\n<!-- block=horse_results (d) -->\n<div class=\"cate_bar\">\n    <h2>\u30d7\u30eb\u30e1\u30ea\u30a2\u30d3\u30fc\u30c1\u306e\u7af6\u8d70\u6210\u7e3e<\/h2>\n    <div class=\"sp_info_box_01 fc\">\n\t<p class=\"fc\">\u30b9\u30de\u30db\u3067\u3082\u3053\u306e\u99ac\u306e\u30c7\u30fc\u30bf\u3092\u30c1\u30a7\u30c3\u30af\uff01<\/p>\n\t<a href=\"https:\/\/www.netkeiba.com\/?pid=sogoch_introduction&id=2024105003\" target=\"_blank\" title=\"\u8a73\u3057\u304f\u898b\u308b\" class=\"popup_link_01\"><img src=\"https:\/\/cdnv2.netkeiba.com\/img.dbv2\/common\/image\/btn_sp_info_link_02.png\" alt=\"\u8a73\u3057\u304f\u898b\u308b\" class=\"imgover\" \/><\/a>\n    <\/div><!-- \/.sp_info_box_01 -->\n<\/div>\n\n\n\n<div class=\"contents\">\n    \u7af6\u8d70\u30c7\u30fc\u30bf\u304c\u3042\u308a\u307e\u305b\u3093\n<\/div>\n\n\n<script type=\"text\/javascript\">\n $(document).on( 'click', '#action_regist', function(){\n     event.preventDefault();\n     var regist_url = 'https:\/\/regist.sp.netkeiba.com\/\/?pid=regist_form&action=nk_input';\n     var callback_url = $('#r_callback').val();\n     action_regist('action_nk_regist', regist_url, callback_url);\n });\n\n function action_regist( modal_id, modal_url, callback_url ) {\n\/\/     console.log('action_regist(%s,%s,%s)', modal_id, modal_url, callback_url);\n\n     $.colorbox({\n\t href: modal_url,\n\t iframe: true,\n\t opacity: '0.5',\n\t open: true,\n\t scrolling: true,\n\t height: '60%',\n\t maxWidth: '90%',\n\t width: $(window).width() - 60 + 'px',\n\t maxWidth: '420px',\n\t overlayClose: true,\n\t escKey: false,\n\t closeButton: true,\n\t onComplete : function(){\n\t     \/\/setHeight();\n\t },\n\t onClosed : function(){\n\t     $('#cboxWrapper').removeClass('SetModal');\n\t }\n     });\n\n     function setHeight() {\n\t var ifrObj = document.getElementById('cboxLoadedContent').querySelectorAll('iframe')[0];\n\t $(ifrObj).on('load', function() {\n\t     var $cBox = $('#colorbox');\n\t     var boxPositionTop = $cBox.offset().top;\n\t     var boxHeight = $cBox.height();\n\t     var ifrBody = ifrObj.contentWindow.document.body;\n\t     var ifrHeight = ifrBody.scrollHeight;\n\t     var movePosition = boxPositionTop + (boxHeight - ifrHeight) \/ 2;\n\t     $('#colorbox').css('top', movePosition +'px');\n\t     $('#cboxLoadedContent').add('#cboxContent').add('#cboxMiddleLeft').add('#cboxWrapper').add('#colorbox').css('height', ifrHeight+'px');\n\t     setTimeout(function () {\n\t\t $('#cboxWrapper').addClass('SetModal');\n\t     }, 100);\n\t });\n     }\n };\n\n $(window).on('message', function(event){\n     if (event.originalEvent.origin !== 'https:\/\/regist.sp.netkeiba.com\/' ) return;\n     if (event.originalEvent.data === 'register_done' ) {\n\t $.colorbox.close();\n\t location.reload();\n     }\n });\n\n<\/script>\n\n<script>\n \/\/ \u30bf\u30a4\u30e0\u6307\u6570\u5207\u66ff\n $(function () {\n     $('.TimeIndexChangeBtn > a').on('click',function(){\n\t $(this).toggleClass('Icon_Change_ArrowB Icon_Change_ArrowT');\n\t $(this).next(\".TimeIndexChangeList\").slideToggle(\"fast\");\n     });\n\n     const STORAGE_KEY = 'timeIndexType';\n     const savedType = localStorage.getItem(STORAGE_KEY);\n\n     if (savedType === 'master') {\n\t $('.TimeIndexHeadCell01,.TimeIndexCell01').hide();\n\t $('.TimeIndexMasterHeadCell01,.TimeIndexMasterCell01').show();\n     } else {\n\t \/\/ \u30c7\u30d5\u30a9\u30eb\u30c8\uff1a\u901a\u5e38\n\t $('.TimeIndexMasterHeadCell01,.TimeIndexMasterCell01').hide();\n\t $('.TimeIndexHeadCell01,.TimeIndexCell01').show();\n     }\n\n     \/\/ \u30bf\u30a4\u30e0\u6307\u6570\uff08\u901a\u5e38\uff09\n     $(document).on('click', '.ChangeTimeIndexNormal', function () {\n\t $('.TimeIndexHeadCell01,.TimeIndexCell01').show();\n\t $('.TimeIndexMasterHeadCell01,.TimeIndexMasterCell01').hide();\n\t localStorage.setItem(STORAGE_KEY, 'normal');\n\t $('.TimeIndexChangeList').slideUp();\n     });\n\n     \/\/ \u30bf\u30a4\u30e0\u6307\u6570\u30de\u30b9\u30bf\u30fc\n     $(document).on('click', '.ChangeTimeIndexMaster', function () {\n\t $('.TimeIndexHeadCell01,.TimeIndexCell01').hide();\n\t $('.TimeIndexMasterHeadCell01,.TimeIndexMasterCell01').show();\n\t localStorage.setItem(STORAGE_KEY, 'master');\n\t $('.TimeIndexChangeList').slideUp();\n     });\n\n });\n\n<\/script>\n\n<script>\n \"use strict\"\n $(function(){\n     const race_ids = [''];\n     const url_movie_check = 'https:\/\/db.netkeiba.com\/race\/ajax_movie_check.html';\n     const url_movie = {\n\t 'jra': 'https:\/\/race.netkeiba.com\/race\/movie.html?race_id=@id@',\n\t 'nar': 'https:\/\/nar.netkeiba.com\/race\/movie.html?race_id=@id@',\n     };\n     \n     \/\/ movie exists check\n     const param = {};\n     param['input'] = 'UTF-8';\n     param['id'] = race_ids;\n     ajax_common(url_movie_check, param, function(data){\n\t if('OK' == data.status){\n\t     for(let i=0; i<data.data.length; i++){\n\t\t $('#v-movie_'+data.data[i]).css('display','block');\n\n\t\t if(data.data[i].substr(4,2) > '10' && data.data[i].substr(4,2) < '99'){\n\t\t     $('#v-movie_'+data.data[i]).attr('href',url_movie['nar'].replace(\/@id@\/,data.data[i]));\n\t\t }else{\n\t\t     $('#v-movie_'+data.data[i]).attr('href',url_movie['jra'].replace(\/@id@\/,data.data[i]));\n\t\t }\n\t     }\n\t }\n     });\n\n     \/\/------------------------------------------------------------\n     function ajax_common(url, param, fn){\n\t let _data = {};\n\t _data.output = 'json';\n\t for(var key in param){\n\t     _data[key] = param[key];\n\t }\n\t $.ajax({\n\t     type: \"POST\",\n\t     url: url,\n\t     data: _data,\n\t     dataType: _data.output,\n\t     success: function(json){\n\t\t if(undefined !== fn){\n\t\t     fn(json);\n\t\t }\n\t     },\n\t     error: function(XMLHttpRequest, textStatus, errorThrown) {\n\t\t console.error('textStatus:',textStatus);\n\t     }\n\t });\n     }\n });\n<\/script>\n\n\n"}