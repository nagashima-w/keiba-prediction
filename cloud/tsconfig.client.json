{
  // スマホ画面のクライアント(client/。Issue #184)の型検査。ブラウザで動くので DOM の型を使う。
  // Worker 側(tsconfig.json)は workers-types を使い、DOM の型と二重定義になるため、別の設定で検査する(types は空)。
  // クライアントは client/ の中と、許可リストの core の表示関数(packages/core/src/view/・analysis/。もとは exe の renderer・shared。#286 で移した)だけを import する(test/client-bundle.test.ts が固定。Issue #185)。
  // 表示関数が import する core のサブパス(`@keiba/core/ev/...`)は、packages/core/node_modules の無い CI でも解決できるよう、paths で実ファイルへ向ける
  // (esbuild もこの paths を読む=型検査とバンドルの解決が揃う。tsconfig.json の paths と同じ対応。バレル `@keiba/core` は向けない)。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Issue #392: 未使用の宣言(import・ローカル変数・引数)を型検査で落とす。実装上使わない引数は先頭に _ を付ける。
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "@keiba/core/*": ["../packages/core/src/*"]
    }
  },
  "include": ["client"]
}
