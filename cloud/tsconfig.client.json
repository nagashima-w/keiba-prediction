{
  // スマホ画面のクライアント(client/。Issue #184)の型検査。ブラウザで動くので DOM の型を使う。
  // Worker 側(tsconfig.json)は workers-types を使い、DOM の型と二重定義になるため、別の設定で検査する(types は空)。
  // クライアントは client/ の中だけを import する(test/client-bundle.test.ts が固定)。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["client"]
}
