{
  // Worker / Durable Object(src/)とテスト(test/)・スモークテスト(smoke.ts)の型検査。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test", "smoke.ts", "vitest.config.ts"]
}
