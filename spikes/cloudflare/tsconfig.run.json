{
  // tsx(実行時)専用。型検査には使わない(型検査は tsconfig.worker.json / tsconfig.node.json)。
  //
  // ドライバは、ランナーからの対照取得のために core の HttpClient・パーサを import する。core の依存
  // (cheerio / iconv-lite)は packages/core/node_modules が CI に無いので、tsx に paths で
  // このディレクトリの node_modules へ向けさせる。tsx は「include に一致するファイル」にだけ paths を
  // 適用するため、core のソースもここで include に含める(型検査の対象にはならないので広くてよい)。
  // tsx の paths はパッケージのディレクトリを解決できない(index を探して失敗する)ので、エントリのファイルを指す。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "undici": ["./src/undici-stub.ts"],
      "iconv-lite": ["./node_modules/iconv-lite/lib/index.js"],
      "cheerio": ["./node_modules/cheerio/dist/esm/index.js"]
    }
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "../../scripts/cloudflare-spike/**/*.ts",
    "../../packages/core/src/**/*.ts"
  ]
}
